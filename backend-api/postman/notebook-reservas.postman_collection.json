      "name": "Professores",
      "item": [
        {
          "name": "Criar professor válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Professor foi criado', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.nome).to.eql('Prof. Teste');",
                  "    pm.expect(jsonData.ativo).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nome\": \"Prof. Teste\", \"email\": \"prof.teste@senai.br\"}"
            },
            "url": {
              "raw": "http://localhost:8080/api/professores",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "professores"]
